{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notifications/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/api" },
    { "src": "^/api(?:/(.*))?$", "dest": "/api" },
    { "src": "^/mark-attendance(?:/(.*))?$", "dest": "/api" },
    { "src": "^/about-developer$", "dest": "/api" },
    { "src": "^/privacy$", "dest": "/api" },
    { "src": "^/terms$", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
