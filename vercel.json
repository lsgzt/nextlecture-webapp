{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/**/node_modules/{pdf-parse,pdfjs-dist,@napi-rs/canvas,@napi-rs/canvas-linux-*}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api$|api/).*)",
      "destination": "/index.html"
    }
  ]
}
