# Existing NextLecture environment variables remain supported.
# LMS browser configuration (use the Supabase publishable key only).
VITE_LMS_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_LMS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Auth email OTP is configured in the Supabase dashboard:
# Authentication > SMTP > use Resend SMTP credentials.
# Never place a Supabase secret/service-role key or Resend API key in VITE_* variables.

# TEMPORARY no-email dev login: the /api/lms/dev-login route provisions
# roster accounts server-side (email_confirm: true, no email sent).
# Server-only — never expose this key to the browser or in VITE_* variables.
LMS_SUPABASE_SERVICE_KEY=sb_secret_...
