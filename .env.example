# NextLecture environment template — copy the values you need.
# NEVER commit real secrets. The browser only ever needs VITE_* values.

# ---------------------------------------------------------------------------
# Faculty attendance portal — SEPARATE "attendance_record" Supabase project.
# Completely independent of any other Supabase configuration below/above.
# ---------------------------------------------------------------------------
# Browser-safe: URL + publishable key of the attendance_record project.
VITE_FACULTY_ATTENDANCE_SUPABASE_URL=https://jchoopzbwihjmhkjulfz.supabase.co
VITE_FACULTY_ATTENDANCE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (scripts/faculty_attendance_*.ts and /api/faculty/sync).
# NEVER put this in a VITE_* variable, the browser bundle, or GitHub.
FACULTY_ATTENDANCE_SUPABASE_URL=https://jchoopzbwihjmhkjulfz.supabase.co
FACULTY_ATTENDANCE_SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret required to call POST /api/faculty/sync (any random string).
FACULTY_SYNC_SECRET=choose-a-long-random-string

# ---------------------------------------------------------------------------
# Existing NextLecture environment variables remain supported.
# ---------------------------------------------------------------------------
# LMS browser configuration (use the Supabase publishable key only).
VITE_LMS_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_LMS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Auth email OTP is configured in the Supabase dashboard:
# Authentication > SMTP > use Resend SMTP credentials.
# Never place a Supabase secret/service-role key or Resend API key in VITE_* variables.

# TEMPORARY no-email dev login: the /api/lms/dev-login route provisions
# roster accounts server-side (email_confirm: true, no email sent).
# Server-only — never expose this key to the browser or in VITE_* variables.
LMS_SUPABASE_SERVICE_KEY=sb_secret_...
